BOT_TOKEN=your_telegram_bot_token_here

# 2 GB full-quality downloads on the SERVER, then upload to Telegram
MAX_FILE_SIZE_MB=2000
MAX_CONCURRENT_DOWNLOADS=10

# REQUIRED for uploads over 50 MB (up to 2 GB):
# Create an app at https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Used by docker-compose (bot talks to local Bot API container)
TELEGRAM_API_BASE_URL=http://telegram-bot-api:8081

DOWNLOAD_DIR=/app/temp
